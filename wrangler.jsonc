{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hello-chat",
  "account_id": "b7cc0719d9ecb3485646785035f87ca1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // The English dictionary the laptop checks chat against (worker/english.ts).
  "rules": [{ "type": "Text", "globs": ["**/*.aff", "**/*.dic"], "fallthrough": true }],

  // The built app (npm run build). Only /api/* runs the Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The class: the live tables and games, plus every student's saved progress.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "ChatRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],

  // PinPlay owns Google sign-in, the roster and student sessions, as for Pixel Plaza.
  "services": [{ "binding": "PINPLAY_AUTH", "service": "pinplay-api" }],

  // Budget for teacher-password and class-PIN guesses. Its own namespace (PinPlay 1001, Dictation Time 2001, Pixel Plaza 3001).
  "ratelimits": [{ "name": "AUTH_RL", "namespace_id": "4001", "simple": { "limit": 50, "period": 60 } }]
}
